---
import Layout from "../layouts/Layout.astro";
---

<Layout title="관리자 | ai politics labs">
	<meta slot="head" name="robots" content="noindex,nofollow" />
		<nav class="pt-10">
			<div class="max-w-[1146px] mx-auto px-6 flex items-center justify-between">
				<a href="/" class="font-medium text-[15.84px] text-stone-900 dark:text-stone-100 tracking-[-0.32px]">
					ai politics labs
				</a>
				<a href="/dashboard" class="text-[14px] text-stone-500 dark:text-stone-400 tracking-[-0.14px] underline underline-offset-4">발기인 대시보드 ↗</a>
			</div>
		</nav>

		<!-- 로그인 폼 -->
		<section id="login-section" class="pt-[60px]">
			<div class="max-w-sm mx-auto px-6">
				<h1 class="font-semibold mb-6 text-[22px] text-stone-800 dark:text-stone-300 tracking-[-0.32px]">관리자 로그인</h1>
				<form id="login-form" class="space-y-4">
					<div>
						<label for="email" class="block text-[14px] font-medium text-stone-700 dark:text-stone-300 tracking-[-0.14px] mb-1.5">이메일</label>
						<input type="email" id="email" required
							class="w-full h-10 px-3 text-[15px] text-stone-900 dark:text-stone-100 bg-white dark:bg-[#0e0e0d] border border-stone-200 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 dark:focus:ring-stone-600 placeholder:text-stone-400 dark:placeholder:text-stone-500 tracking-[-0.14px]"
							placeholder="admin@example.com" />
					</div>
					<div>
						<label for="password" class="block text-[14px] font-medium text-stone-700 dark:text-stone-300 tracking-[-0.14px] mb-1.5">비밀번호</label>
						<input type="password" id="password" required
							class="w-full h-10 px-3 text-[15px] text-stone-900 dark:text-stone-100 bg-white dark:bg-[#0e0e0d] border border-stone-200 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 dark:focus:ring-stone-600 placeholder:text-stone-400 dark:placeholder:text-stone-500 tracking-[-0.14px]" />
					</div>
					<div id="login-error" class="hidden p-3 bg-red-50 rounded-xl text-[13px] text-red-600"></div>
					<button type="submit" id="login-btn"
						class="inline-flex items-center justify-center h-10 px-6 text-sm font-medium text-white dark:text-stone-900 bg-[#222222] dark:bg-white rounded-full hover:bg-[#333333] dark:hover:bg-stone-200 transition-colors tracking-[-0.14px] w-full">
						로그인
					</button>
				</form>
			</div>
		</section>

		<!-- 데이터 테이블 -->
		<section id="data-section" class="hidden pt-[60px] pb-24">
			<div class="max-w-[1146px] mx-auto px-6">
				<div class="flex items-center justify-between mb-6">
					<h1 class="font-semibold text-[22px] text-stone-800 dark:text-stone-300 tracking-[-0.32px]">
						발기인 접수 목록 <span id="total-count" class="text-stone-400 dark:text-stone-500 text-[15px] font-normal"></span>
					</h1>
					<button id="logout-btn"
						class="text-[13px] text-stone-400 dark:text-stone-500 hover:text-stone-600 dark:hover:text-stone-300 transition-colors tracking-[-0.14px]">
						로그아웃
					</button>
				</div>

				<details id="paper-import" class="mb-8 bg-stone-100 dark:bg-white/[0.03] rounded-2xl p-6">
					<summary class="cursor-pointer text-[15px] font-semibold text-stone-800 dark:text-stone-300 tracking-[-0.14px]">종이 동의서 등록</summary>
					<p class="mt-3 text-[13px] text-stone-500 dark:text-stone-400 tracking-[-0.14px] leading-relaxed">
						구글 드라이브 검토표에서 머리줄을 포함해 표를 복사해 붙여넣으세요. 열 순서: 이름, 생년월일, 성별, 직업, 주소, 휴대폰, 자택전화, 작성일, 서명, 사진ID, 확인필요.
						확인필요 칸이 비어 있는 줄만 등록됩니다. 온라인·종이 기존 발기인과 이름+생년월일 또는 휴대폰이 같으면 등록하지 않습니다.
					</p>
					<textarea id="paper-input" rows="6" class="mt-3 w-full p-3 text-[13px] font-mono text-stone-900 dark:text-stone-100 bg-white dark:bg-[#0e0e0d] border border-stone-200 dark:border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-stone-300 dark:focus:ring-stone-600"></textarea>
					<div class="mt-3 flex gap-2">
						<button id="paper-check" class="h-9 px-5 text-[13px] font-medium border border-stone-300 dark:border-white/20 rounded-full text-stone-700 dark:text-stone-300">검사</button>
						<button id="paper-commit" disabled class="h-9 px-5 text-[13px] font-medium text-white dark:text-stone-900 bg-[#222222] dark:bg-white rounded-full disabled:opacity-40">등록</button>
					</div>
					<div id="paper-result" class="mt-4 text-[13px] tracking-[-0.14px]"></div>
				</details>

				<div id="loading" class="text-[15px] text-stone-400 dark:text-stone-500 tracking-[-0.14px]">불러오는 중...</div>
				<div id="members-list" class="space-y-4"></div>
			</div>
		</section>

		<!-- 서명 확대 모달 -->
		<div id="signature-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-6" role="dialog" aria-modal="true" aria-labelledby="modal-name">
			<div class="bg-white dark:bg-[#0e0e0d] rounded-2xl p-6 max-w-lg w-full">
				<div class="flex items-center justify-between mb-4">
					<p id="modal-name" class="text-[15px] font-semibold text-stone-800 dark:text-stone-300 tracking-[-0.14px]"></p>
					<button id="close-modal" class="text-stone-400 dark:text-stone-500 hover:text-stone-600 dark:hover:text-stone-300 transition-colors text-[20px]">&times;</button>
				</div>
				<img id="modal-signature" class="w-full border border-stone-200 dark:border-white/10 rounded-xl" alt="서명" />
			</div>
		</div>

		<script type="module">
			import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

			const SUPABASE_URL = 'https://bsiatqjivenmblkcujjw.supabase.co';
			const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJzaWF0cWppdmVubWJsa2N1amp3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI3ODk2OTMsImV4cCI6MjA4ODM2NTY5M30.ReRm1mteN7bsWiRoMhHc8EfhLncJuLZ_8hSR-El8-S4';
			const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

			const loginSection = document.getElementById('login-section');
			const dataSection = document.getElementById('data-section');
			const loginForm = document.getElementById('login-form');
			const loginError = document.getElementById('login-error');
			const membersList = document.getElementById('members-list');
			const loading = document.getElementById('loading');
			const totalCount = document.getElementById('total-count');

			// Check existing session
			const { data: { session } } = await supabase.auth.getSession();
			if (session) {
				showData();
			}

			// Login
			loginForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				loginError.classList.add('hidden');
				const email = document.getElementById('email').value;
				const password = document.getElementById('password').value;

				const { error } = await supabase.auth.signInWithPassword({ email, password });
				if (error) {
					loginError.textContent = '로그인 실패: ' + error.message;
					loginError.classList.remove('hidden');
					return;
				}
				showData();
			});

			// Logout
			document.getElementById('logout-btn').addEventListener('click', async () => {
				await supabase.auth.signOut();
				loginSection.classList.remove('hidden');
				dataSection.classList.add('hidden');
			});

			// Load data
			async function showData() {
				const { data: allowed, error: permissionError } = await supabase.rpc('is_site_admin');
				if (permissionError || allowed !== true) {
					loginError.textContent = '운영자 계정으로 로그인해 주세요. 일반 계정은 관리자 자료를 조회할 수 없습니다.';
					loginError.classList.remove('hidden');
					dataSection.classList.add('hidden');
					loginSection.classList.remove('hidden');
					return;
				}
				loginSection.classList.add('hidden');
				dataSection.classList.remove('hidden');
				loading.classList.remove('hidden');
				membersList.innerHTML = '';

				const { data, error } = await supabase
					.from('founding_members')
					.select('*')
					.order('created_at', { ascending: false });

				loading.classList.add('hidden');

				if (error) {
					membersList.textContent = '';
					membersList.appendChild(el('p', 'text-red-500 text-[14px]', '데이터 로드 실패: ' + error.message));
					return;
				}

				totalCount.textContent = `(${data.length}명)`;

				if (data.length === 0) {
					membersList.innerHTML = '<p class="text-stone-400 dark:text-stone-500 text-[15px]">아직 접수된 발기인이 없습니다.</p>';
					return;
				}

				const frag = document.createDocumentFragment();
				data.forEach((m) => {
					const card = el('div', 'bg-stone-100 dark:bg-white/[0.03] rounded-2xl p-6');
					const row = el('div', 'flex items-start justify-between gap-4');

					const info = el('div', 'flex-1 min-w-0');
					const head = el('div', 'flex items-center gap-3 mb-3');
					head.append(
						el('span', 'text-[15px] font-semibold text-stone-900 dark:text-stone-100 tracking-[-0.14px]', m.name),
						el('span', 'text-[13px] text-stone-400 dark:text-stone-500 tracking-[-0.14px]', `${m.gender ?? ''} · ${m.birth_date ?? ''}`),
						el('span', 'text-[12px] text-stone-300 dark:text-stone-600 tracking-[-0.14px]', m.created_at ? new Date(m.created_at).toLocaleString('ko-KR') : ''),
						el('span', m.public_consent
							? 'text-[11px] font-medium text-stone-700 dark:text-stone-300 bg-stone-200 dark:bg-white/10 rounded-full px-2 py-0.5'
							: 'text-[11px] font-medium text-stone-400 dark:text-stone-500 border border-stone-300 dark:border-white/10 rounded-full px-2 py-0.5',
							m.public_consent ? '공개 동의' : '비공개'),
						m.source === 'paper'
							? el('span', 'text-[11px] font-medium text-amber-700 dark:text-amber-300 bg-amber-100 dark:bg-amber-500/10 rounded-full px-2 py-0.5', '종이')
							: el('span', 'text-[11px] text-stone-400 dark:text-stone-500', '온라인'),
					);
					const grid = el('div', 'grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-[13px] tracking-[-0.14px]');
					grid.append(
						field('주소', m.address),
						field('직업', m.occupation),
						field('휴대폰', m.phone_mobile),
						field('자택', m.phone_home || '-'),
						field('추천인', m.referrer || '-'),
					);
					info.append(head, grid);

					if (m.source === 'paper') {
						const link = el('a', 'shrink-0 text-[13px] text-stone-600 dark:text-stone-300 underline underline-offset-4', '원본 사진 ↗');
						if (/^[A-Za-z0-9_-]{10,200}$/.test(m.paper_ref || '')) link.href = 'https://drive.google.com/file/d/' + m.paper_ref + '/view';
						link.target = '_blank';
						link.rel = 'noopener noreferrer';
						row.append(info, link);
						card.appendChild(row);
						frag.appendChild(card);
						return;
					}

					const btn = el('button', 'sig-btn shrink-0 border border-stone-200 dark:border-white/10 rounded-xl overflow-hidden hover:border-stone-400 dark:hover:border-white/30 transition-colors');
					const img = el('img', 'w-[120px] h-[60px] object-contain bg-white');
					if (isDataUrl(m.signature_data)) img.src = m.signature_data;
					img.alt = '서명';
					btn.appendChild(img);
					btn.addEventListener('click', () => {
						document.getElementById('modal-name').textContent = (m.name ?? '') + ' 서명';
						const ms = document.getElementById('modal-signature');
						if (isDataUrl(m.signature_data)) ms.src = m.signature_data; else ms.removeAttribute('src');
						document.getElementById('signature-modal').classList.remove('hidden');
					});

					row.append(info, btn);
					card.appendChild(row);
					frag.appendChild(card);
				});
				membersList.appendChild(frag);
			}

			// 종이 동의서 등록
			const paperInput = document.getElementById('paper-input');
			const paperResult = document.getElementById('paper-result');
			const paperCommit = document.getElementById('paper-commit');
			let paperRows = null;

			function parsePaper(text) {
				const lines = text.split(/\r?\n/).filter((l) => l.trim() !== '');
				const rows = [];
				const blocked = [];
				lines.forEach((line) => {
					const c = (line.includes('\t') ? line.split('\t') : line.split(',')).map((v) => v.trim());
					if (c[0] === '이름') return;
					const r = {
						name: c[0] || '', birth_date: c[1] || '', gender: c[2] || '', occupation: c[3] || '',
						address: c[4] || '', phone_mobile: c[5] || '', phone_home: c[6] || '', agreed_at: c[7] || '',
						signature: /^(있음|o|y|yes|true|1|✓|✔)$/i.test(c[8] || ''), paper_ref: c[9] || '',
					};
					if ((c[10] || '') !== '') blocked.push({ name: r.name, reason: '확인필요: ' + c[10] });
					else rows.push(r);
				});
				return { rows, blocked };
			}

			const STATUS = { ok: '등록 가능', registered: '등록됨', duplicate: '중복', invalid: '확인 필요' };
			function renderPaper(results, blocked) {
				paperResult.textContent = '';
				const list = el('ul', 'space-y-1');
				results.forEach((r) => {
					const good = r.status === 'ok' || r.status === 'registered';
					const li = el('li', good ? 'text-stone-700 dark:text-stone-300' : 'text-red-600 dark:text-red-400',
						`${r.name || '(이름 없음)'} · ${STATUS[r.status] || r.status}${r.reason ? ' · ' + r.reason : ''}`);
					list.appendChild(li);
				});
				blocked.forEach((b) => list.appendChild(el('li', 'text-red-600 dark:text-red-400', `${b.name || '(이름 없음)'} · 건너뜀 · ${b.reason}`)));
				paperResult.appendChild(list);
			}

			async function runPaper(commit) {
				const { rows, blocked } = parsePaper(paperInput.value);
				if (rows.length === 0) {
					paperResult.textContent = blocked.length ? '' : '붙여넣은 줄이 없습니다.';
					if (blocked.length) renderPaper([], blocked);
					paperCommit.disabled = true;
					return null;
				}
				const { data, error } = await supabase.rpc('admin_import_paper_founders', { p_rows: commit ? paperRows : rows, p_commit: commit });
				if (error) {
					paperResult.textContent = '실패: ' + error.message;
					paperCommit.disabled = true;
					return null;
				}
				renderPaper(data, blocked);
				return { data, rows };
			}

			document.getElementById('paper-check').addEventListener('click', async () => {
				paperCommit.disabled = true;
				const res = await runPaper(false);
				if (!res) return;
				paperRows = res.rows.filter((_, i) => res.data[i] && res.data[i].status === 'ok');
				paperCommit.disabled = paperRows.length === 0;
				paperCommit.textContent = paperRows.length ? `${paperRows.length}명 등록` : '등록';
			});
			paperInput.addEventListener('input', () => { paperCommit.disabled = true; paperCommit.textContent = '등록'; });
			paperCommit.addEventListener('click', async () => {
				if (!paperRows || paperRows.length === 0) return;
				paperCommit.disabled = true;
				const res = await runPaper(true);
				paperRows = null;
				paperCommit.textContent = '등록';
				if (res) showData();
			});

			// Modal close
			const modal = document.getElementById('signature-modal');
			function closeModal() { modal.classList.add('hidden'); }
			document.getElementById('close-modal').addEventListener('click', closeModal);
			modal.addEventListener('click', (e) => {
				if (e.target === e.currentTarget) closeModal();
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
			});

			// DOM helpers (XSS-safe: text via textContent, never innerHTML)
			function el(tag, className, text) {
				const node = document.createElement(tag);
				if (className) node.className = className;
				if (text != null) node.textContent = text;
				return node;
			}
			function field(label, value) {
				const p = document.createElement('p');
				p.append(el('span', 'text-stone-400 dark:text-stone-500', label), ' ', el('span', 'text-stone-700 dark:text-stone-300 ml-2', value ?? '-'));
				return p;
			}
			function isDataUrl(s) {
				return typeof s === 'string' && /^data:image\//.test(s);
			}
		</script>
</Layout>
